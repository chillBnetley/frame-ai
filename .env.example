# FRAME AI — backend configuration (phase 2 / phase 3)
# Copy this file to the repository root as `.env`.
# services/api reads it automatically; real secrets must never be committed.
# The API is local-only (D-13). Bind uvicorn to 127.0.0.1 and never expose it
# to a public network or reverse proxy.

FRAME_ENVIRONMENT=development
FRAME_LOG_LEVEL=INFO

# Optional. Defaults to <repository>/data.
# Relative paths resolve against the repository root, not the current directory.
# FRAME_DATA_DIR=C:/absolute/path/to/frame-ai-data

# SQLite database file inside the data directory.
FRAME_DATABASE_FILENAME=frame.db

# Preview cache (data/tmp/previews). Files older than TTL are removed at
# startup and every cleanup interval at runtime.
FRAME_PREVIEW_TTL_SECONDS=3600
FRAME_PREVIEW_CLEANUP_INTERVAL_SECONDS=600

# Longest edge for final previews and the hard preview limit.
FRAME_RENDER_MAX_EDGE_DEFAULT=1600
FRAME_RENDER_MAX_EDGE_LIMIT=2560

# In-process LRU budget, in MB, for decoded render proxies. A cached proxy is
# reused across slider moves so each preview decodes the original once per
# longest edge. Set to 0 to disable; entries that are not exactly 8-bit
# representable are never cached, so output is byte-identical either way.
FRAME_PROXY_CACHE_MB=64

# In-process LRU budget, in MB, for computed local-mask weights. Slider moves
# re-render the same mask geometry, so the weights are reused instead of being
# recomputed per render. Entries above 24 MB (about 6 MP of float32 weights) are
# never cached. Set to 0 to disable; results are byte-identical either way.
FRAME_MASK_CACHE_MB=64

# Exports admitted at the same time (1-4). Admission also checks that the sum of
# the running exports' estimated peaks stays under FRAME_EXPORT_MAX_RSS_MB, so
# raising this only parallelises small exports; a large export still gets
# 503 server_busy while the budget is occupied. Keep 1 on a small machine.
FRAME_EXPORT_MAX_CONCURRENCY=1

# Export peak-memory budget in MB. The API estimates peak memory from pixel
# count and recipe complexity before decoding and rejects budgets above this
# limit with 413 export_too_large. scripts/bench_render.py also asserts the
# measured RSS against it. This is a conservative estimate, not a live RSS cap;
# FRAME_EXPORT_RESERVE_MB below adds the real-available-memory check.
#
# Coefficients were recalibrated in the stage 3/4 review remediation (G4)
# against 8 measured peaks: 45 B/px neutral, 160 B/px for any other recipe,
# 8 B/px per active local adjustment, 150 MB baseline, and a floor of 45 B/px
# over the original because decoding always reads it whole. The neutral 45 B/px
# and local +8 B/px are unchanged from phase 4 Task 8; full recipes dropped from
# 240 to 160 B/px (highest measured peak 131 B/px). At 3072 MB a 24 MP
# full-recipe export at original size is still refused (estimate 3812 MB,
# measured 2907 MB); picking long edge 2400 fits (estimate 1180 MB, measured
# 794 MB), or raise this budget if the machine has the headroom.
FRAME_EXPORT_MAX_RSS_MB=3072

# Second admission gate: after the static estimate fits the budget above, the
# API also asks psutil for the memory actually available and refuses the export
# with 503 server_busy when available - estimate < FRAME_EXPORT_RESERVE_MB.
# Set to 0 to keep only the static estimate.
FRAME_EXPORT_RESERVE_MB=256

# Above this pixel count, exports with denoise enabled use a simplified
# denoise window and add X-Export-Warning: denoise_simplified. Preview and
# export detail may then differ slightly for very large images.
FRAME_EXPORT_DENOISE_SIMPLIFY_PIXELS=12000000

# 20 MiB. Keep NEXT_PUBLIC_MAX_UPLOAD_BYTES in apps/web/.env.local in sync.
FRAME_MAX_UPLOAD_BYTES=20971520

# 40 megapixels.
FRAME_MAX_IMAGE_PIXELS=40000000

# Multipart overhead allowance for the early Content-Length check.
FRAME_CONTENT_LENGTH_ALLOWANCE=1048576

# 2 MiB. JSON writes (sessions, render, export, settings, analysis) get their own
# budget so a large body cannot reach the image-upload limit. A worst-case recipe
# (32 curve points + 8 masks + 24 local adjustments) is far below this.
FRAME_MAX_JSON_BODY_BYTES=2097152

# Comma-separated browser origins allowed to call the API directly.
FRAME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated Host header values accepted by the API (DNS rebinding guard).
FRAME_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# Phase 3 analysis providers. `mock` is the default and never calls a network.
# Selecting `openai` requires the API key, model, and base URL for that provider;
# startup fails with a configuration error instead of silently falling back.
# These values are the fallback: the in-app "模型设置" dialog saves overrides to
# <FRAME_DATA_DIR>/provider-settings.json, and saved fields take precedence.
# "恢复环境变量配置" in the dialog deletes the override file. API keys may be left
# empty here if they are entered in the dialog; either way they stay server-side.
# Never put real API keys in this file or commit them.
FRAME_VISION_PROVIDER=mock
FRAME_VISION_API_KEY=
FRAME_VISION_MODEL=
FRAME_VISION_API_BASE_URL=
FRAME_VISION_TIMEOUT=60
FRAME_VISION_MAX_RETRIES=2
FRAME_VISION_REPAIR_ATTEMPTS=1

FRAME_DECISION_PROVIDER=mock
FRAME_DECISION_API_KEY=
FRAME_DECISION_MODEL=
FRAME_DECISION_API_BASE_URL=
FRAME_DECISION_TIMEOUT=60
FRAME_DECISION_MAX_RETRIES=2
FRAME_DECISION_REPAIR_ATTEMPTS=1

# Mock vision scene: generic, portrait, landscape, low_light, or backlit.
FRAME_MOCK_SCENARIO=generic

# Longest edge of the in-memory analysis copy sent to the vision provider.
# The original file is never modified. Allowed range: 512-2048.
FRAME_ANALYSIS_MAX_EDGE=1024

# Bounded worker pool for background analysis tasks.
FRAME_ANALYSIS_MAX_CONCURRENCY=2

# Attempts allowed before an interrupted task is marked failed at startup.
FRAME_ANALYSIS_MAX_ATTEMPTS=2

# Maximum size of the JPEG copy sent to the vision provider (8 MiB).
FRAME_ANALYSIS_MAX_INPUT_BYTES=8388608

# Whole-task budget in seconds. Checked at every stage boundary, so a stalled
# provider fails the task with analysis_timeout instead of hanging forever. Keep
# it above provider timeout x (1 + retries) x (1 + repair attempts), or a slow but
# healthy provider run will be cut off.
FRAME_ANALYSIS_TIMEOUT_SECONDS=600

# Pending tasks accepted before POST /api/v1/analysis answers 503 server_busy.
# Bounds memory when many analyses are requested at once.
FRAME_ANALYSIS_QUEUE_MAX=16
