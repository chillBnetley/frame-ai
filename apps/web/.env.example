# FRAME AI — frontend configuration (phase 1)
# Copy this file to apps/web/.env.local.

# Server-side target for the /api/v1 rewrite proxy.
API_INTERNAL_URL=http://127.0.0.1:8000

# Leave empty to call the same-origin Next.js proxy.
# Set an absolute URL only when calling FastAPI directly (CORS applies).
NEXT_PUBLIC_API_BASE_URL=

# Must not exceed the backend FRAME_MAX_UPLOAD_BYTES value.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=20971520
